# Copia questo file in ".env" e inserisci i tuoi valori reali.
# NON caricare mai il file ".env" (con le chiavi vere) su GitHub o in un posto pubblico.

# Dashboard Stripe -> Sviluppatori -> Chiavi API -> "Chiave segreta"
# Usa la chiave che inizia con sk_test_... finche' fai le prove.
# Passa a sk_live_... solo quando sei pronto a incassare per davvero.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL pubblico del tuo sito, quello che i clienti visitano
SITE_URL=https://ordinem.tuodominio.it

# Porta su cui gira questo backend (di solito impostata automaticamente da Render/Railway)
PORT=4242
